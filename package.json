{
  "name": "unifi2mqtt",
  "version": "2.0.1",
  "description": "Interface between Ubiquiti UniFi network controllers and MQTT (client presence, devices, WLANs)",
  "type": "module",
  "main": "index.js",
  "bin": {
    "unifi2mqtt": "index.js"
  },
  "preferGlobal": true,
  "files": [
    "index.js",
    "config.js",
    "lib/"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "deploy": "bash deploy.sh"
  },
  "keywords": [
    "unifi",
    "ubiquiti",
    "presence",
    "device-tracker",
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "mqtt-interfaces",
    "home-automation",
    "home-assistant"
  ],
  "author": "Sebastian 'Hobbyquaker' Raff <hobbyquaker@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/unifi2mqtt.git"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/unifi2mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/unifi2mqtt#readme",
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "UNIFI2MQTT",
    "needs": [
      "network"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "mqtt-interfaces-core": "^0.6.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
